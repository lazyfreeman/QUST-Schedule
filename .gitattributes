# 统一换行符：文本文件在仓库与检出时均为 LF
* text=auto eol=lf

# Windows 批处理脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix 脚本保持 LF
*.sh text eol=lf
gradlew text eol=lf

# 二进制文件不做换行符转换
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.zip binary
*.so binary